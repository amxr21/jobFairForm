# ─── Job Fair frontend — LOCAL environment template ────────────────
# Copy to .env and fill in real values:  cp .env.local.example .env
# NEVER commit .env.
#
# This is the LOCAL template: it points at a backend running on this
# machine. To point the local frontend at the deployed backend instead,
# copy .env.remote.example — do NOT hand-edit this file's values.
#
# That hand-editing is exactly what broke before: this file's comment
# said "local dev, port 2001" while its value was the production URL,
# so local dev silently talked to production and the comment that
# should have caught it was the thing doing the lying.
#
# VITE_* values are exposed to the browser. Never put a secret here.

# ─── Mode ──────────────────────────────────────────────────────────
# One of: local | demo | prod. Declared explicitly, never inferred.
VITE_APP_MODE=local

# ─── API ───────────────────────────────────────────────────────────
# NO trailing slash: src/config/api.js callers build
# `${API_URL}/applicants`, so a trailing slash yields `//applicants`.
#
# Start the backend first (`npm run dev` in ../backend) or every
# request fails to connect. It listens on 2001 by default.
VITE_API_URL=http://localhost:2001
