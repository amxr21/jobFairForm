# Frontend Environment Variables
# Copy this file to .env and set VITE_API_URL.

# ─── Backend API URL ──────────────────────────────────────────────────────────
# REQUIRED for production builds. Vite inlines this at BUILD time, so changing
# it on a hosting provider requires a REDEPLOY — restarting the service is not
# enough, and it must be set as a BUILD-time variable, not a runtime one.
#
# There is no production fallback host in src/config/api.js: a production build
# with this unset throws on startup rather than silently calling a dead server.
#
# Local backend (run `npm run dev` in form/backend, listens on port 2001):
VITE_API_URL=http://localhost:2001

# Deployed backend — set this to your actual backend host in the hosting
# provider's build environment variables, e.g.:
# VITE_API_URL=https://form-api.your-domain.com
