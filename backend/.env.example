# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Port
PORT=2001

# ─── MySQL / Prisma ───────────────────────────────────────────────────────────
# Points at the SAME database as apps/dashboard/backend. Any special characters
# in the username/password (e.g. @, :, /) must be percent-encoded (@ -> %40) or
# Prisma will mis-parse the host/port.
#
# On a hosting provider set this as a BUILD-time variable too: `postinstall`
# runs `prisma generate`, which loads prisma.config.cjs.
DATABASE_URL=mariadb://user:password@localhost:3306/jobfair

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API, on top of the
# built-in localhost dev origins. Every deployed frontend host must be listed
# here or the browser will block its requests.
ALLOWED_ORIGINS=https://job-fair-form.vercel.app

# JWT Secret Key - Use a strong random string in production
TOKEN_SIGN=your_jwt_secret_key_here

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
