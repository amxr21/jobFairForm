# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Port
PORT=2001

# ─── MySQL / Prisma ───────────────────────────────────────────────────────────
# Points at the SAME database as apps/dashboard/backend. Any special characters
# in the username/password (e.g. @, :, /) must be percent-encoded (@ -> %40) or
# Prisma will mis-parse the host/port.
#
# Runtime only — this does NOT need to be a build variable. `postinstall` runs
# `prisma generate`, which loads prisma.config.cjs, and that falls back to a
# placeholder URL so generation never needs a reachable database.
DATABASE_URL=mariadb://user:password@localhost:3306/jobfair

# On Coolify the host is the database CONTAINER UUID (revealed by the eye icon
# on the internal connection URL), not the friendly resource name — the name
# does not resolve and fails with EAI_AGAIN:
# DATABASE_URL=mysql://jobfair:password@a40k0sgowg0ckw4w448k4gko:3306/jobfair

# ─── Database TLS (managed hosts only) ────────────────────────────────────────
# Only needed when the database is reached over the public internet, e.g. the
# previous Aiven setup. Leave BOTH unset on Coolify: that traffic stays on the
# internal Docker network, and setting either one turns on TLS against a server
# that is not serving it. DB_CA_CERT holds the certificate CONTENTS (certs/ is
# gitignored, so a file path does not survive a deploy from git).
# DB_CA_CERT=
# DB_CA_CERT_PATH=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API, on top of the
# built-in localhost dev origins. Every deployed frontend host must be listed
# here or the browser will block its requests.
ALLOWED_ORIGINS=https://form.amxr.site

# JWT Secret Key - Use a strong random string in production
TOKEN_SIGN=your_jwt_secret_key_here

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
