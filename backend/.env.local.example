# ─── Job Fair backend — LOCAL environment template ─────────────────
# Copy to .env and fill in real values:  cp .env.local.example .env
# NEVER commit .env.
#
# This is the LOCAL template: every value points at something running on
# this machine. To run against a deployed backend instead, copy
# .env.remote.example — do NOT hand-edit this file's values, because the
# comments then stop matching the values and the next person to read it
# is misled.

# ─── Mode ──────────────────────────────────────────────────────────
# One of: local | demo | prod. Declared explicitly, never inferred from
# NODE_ENV or from whether a URL contains "localhost".
APP_MODE=local

# ─── Runtime ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=2001

# ─── Database ──────────────────────────────────────────────────────
# MUST be reachable from THIS machine.
#
# The deployed value is a Coolify container UUID (see
# .env.remote.example). That name resolves only inside the server's
# Docker network — locally it fails before any connection attempt with
# "error parsing connection string", which names neither the cause nor
# the fix. Do not copy it here.
#
# Local MariaDB/MySQL:
DATABASE_URL=mariadb://root:password@localhost:3306/jobfair
#
# The schema is not in prisma/migrations — load it with:
#   npm run load-schema

# ─── Database TLS ──────────────────────────────────────────────────
# Leave unset for a local database: setting either one turns on TLS
# against a server that is not serving it.
# DB_CA_CERT=
# DB_CA_CERT_PATH=

# ─── Auth ──────────────────────────────────────────────────────────
# Any non-empty string works locally; it only needs to be secret in
# deployed environments. Generate with: openssl rand -base64 32
TOKEN_SIGN=local-dev-only-not-a-real-secret

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated. localhost:3000 (Vite's configured port), :3001 and
# :5173 are already built into app.js, so this can stay empty locally.
ALLOWED_ORIGINS=

# ─── Cloudinary (CV uploads) ───────────────────────────────────────
# server.js warns at startup if these are missing, and every CV upload
# fails at request time. Use a free personal Cloudinary account for
# local dev rather than the production credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email (ticket confirmations) ──────────────────────────────────
# Read by controllers/applicantsControllers.js. Leave blank locally
# unless you are specifically testing ticket emails — sending is
# wrapped in .catch(), so a failure logs rather than breaking submit.
#
# NOTE: line 327 of that controller reads process.env.USER_EMAIL, which
# nothing sets — it looks like a typo for EMAIL_USER, and makes the
# ticket email's From read "CASTO Office <undefined>".
EMAIL_USER=
EMAIL_PASS=
