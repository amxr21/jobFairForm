# ─── Job Fair backend — REMOTE environment template ────────────────
# The shape of a DEPLOYED backend. Placeholders only — never commit a
# real password, secret or key here. Set these in Coolify's environment
# variables for the service.
#
# To run locally, copy .env.local.example instead. The values below are
# deliberately NOT usable from a developer machine (see Database).

# ─── Mode ──────────────────────────────────────────────────────────
# One of: local | demo | prod.
# `demo` is a first-class mode, not a flavour of prod: a demo deploy
# points at demo data and must stay visibly distinguishable, so demo
# records are never mistaken for real applicants.
APP_MODE=prod

# ─── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=2001

# ─── Database ──────────────────────────────────────────────────────
# On Coolify the host is the database CONTAINER UUID — revealed by the
# eye icon on the internal connection URL — NOT the friendly resource
# name, which does not resolve and fails with EAI_AGAIN.
#
# This host is reachable only from inside Coolify's Docker network.
# That is expected: local dev uses .env.local.example, it does not
# borrow this line.
DATABASE_URL=mysql://user:password@<container-uuid>:3306/<database>

# ─── Database TLS (managed hosts on the public internet only) ──────
# Leave BOTH unset on Coolify — that traffic stays on the internal
# Docker network, and setting either turns on TLS against a server that
# is not serving it. DB_CA_CERT holds the certificate CONTENTS, since
# certs/ is gitignored and a file path does not survive a git deploy.
# DB_CA_CERT=
# DB_CA_CERT_PATH=

# ─── Auth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
TOKEN_SIGN=generate-a-real-secret-do-not-reuse-the-local-one

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of every deployed frontend origin. Hardcoding
# these in app.js is what previously left a new frontend host
# permanently blocked, needing a code change instead of a config change.
ALLOWED_ORIGINS=https://form.amxr.site

# ─── Cloudinary (CV uploads) ───────────────────────────────────────
# server.js fails loudly at startup if these are missing, rather than
# letting every CV upload fail mysteriously at request time.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email (ticket confirmations) ──────────────────────────────────
# Sends via smtp.outlook.com:587 (see applicantsControllers.js).
#
# NOTE: line 327 of that controller reads process.env.USER_EMAIL, which
# nothing sets — it looks like a typo for EMAIL_USER, and makes the
# ticket email's From read "CASTO Office <undefined>".
EMAIL_USER=internshipfair@sharjah.ac.ae
EMAIL_PASS=your-smtp-app-password
